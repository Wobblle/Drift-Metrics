# =============================================================================
# Drift-Metrics — .gitignore
# =============================================================================

# ---- Secrets / env ---------------------------------------------------------
# Never commit filled-in env files. The .example variants are tracked.
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example

# Supabase CLI artifacts (cached versions, linked-project info — local-only)
supabase/.temp/
supabase/.branches/

# ---- Build outputs ---------------------------------------------------------
# Bundled Acurast job — produced by `deno run -A acurast/build.ts`.
# Re-creatable from source; no need to commit.
acurast/dist/

# Local report dumps from running siphon directly (if you ever bring back
# the Python path for dev testing).
reports/
*.report.json

# ---- Dependencies ----------------------------------------------------------
node_modules/
package-lock.json.bak

# ---- Editor / OS noise -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Allow specific files that match patterns above ------------------------
# (Any explicit unignores go here; for now nothing.)
